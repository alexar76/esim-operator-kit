{
  "name": "travel-esim",
  "version": "0.1.0",
  "private": true,
  "description": "The storefront for travellers: pick a country, pay in crypto (USDC on Base, USDT or TON on TON; Stripe pluggable), get the eSIM's QR. Gitea-only.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pretest": "node -e \"require('fs').existsSync('../rails/node_modules') || require('child_process').execSync('npm ci --prefix ../rails --no-audit --no-fund', { stdio: 'inherit' })\"",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "@tonconnect/ui": "5.0.1",
    "@x402/core": "2.30.0+aimarket.zod4.1",
    "@x402/evm": "2.30.0+aimarket.zod4.1",
    "@x402/express": "2.30.0",
    "@x402/extensions": "2.30.0+aimarket.zod4.1",
    "express": "5.3.0",
    "mermaid": "12.3.0",
    "qrcode": "1.5.4",
    "viem": "2.57.16",
    "@aimarket/x402-cdp": "0.1.0",
    "zod": "4.6.7",
    "deepmerge": "file:vendor/aimarket-deepmerge-safe-1.0.0.tgz"
  },
  "bundleDependencies": [
    "@x402/core",
    "@x402/evm",
    "@x402/express",
    "@x402/extensions",
    "@aimarket/x402-cdp"
  ],
  "overrides": {
    "deepmerge": "$deepmerge"
  }
}
