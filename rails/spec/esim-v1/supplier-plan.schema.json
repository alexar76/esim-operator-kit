{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexar76/esim-operator-kit/blob/main/rails/spec/esim-v1/supplier-plan.schema.json",
  "title": "A plan from the operator's own system (HTTP supplier GET /catalog → {plans: [Plan]})",
  "type": "object",
  "required": [
    "id",
    "name",
    "countries",
    "data_bytes",
    "days",
    "cost_usd"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.,-]{1,64}$"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "kind": {
      "enum": [
        "country",
        "region",
        "global"
      ]
    },
    "data_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "days": {
      "type": "integer",
      "minimum": 1
    },
    "speed": {
      "type": "string"
    },
    "networks": {
      "type": "array"
    },
    "top_up": {
      "type": "boolean"
    },
    "unused_valid_days": {
      "type": [
        "integer",
        "null"
      ]
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0,
      "description": "your cost; never shown to buyers"
    }
  }
}
