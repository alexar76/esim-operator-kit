# ── Your store ────────────────────────────────────────────────────────────────────────
# The domain whose DNS A record points at this server. Caddy gets its certificate.
DOMAIN=esim.example.com
STORE_NAME=My Travel eSIM
# A short slug for your offers in the federation (letters, digits, dashes).
PRODUCT_ID=esim-mytravel
STORE_CONTACT=support@example.com
# eSIM Access asks every reseller's site for terms and a privacy policy. Link yours:
STORE_TERMS_URL=https://example.com/terms
STORE_PRIVACY_URL=https://example.com/privacy

# Your price = wholesale × (1 + MARGIN_PCT/100), never less than wholesale + MIN_MARGIN_USD.
# Wholesale data is cheap (France 1 GB / 7 days ≈ $0.70); retail stores ask $4–8 for it.
# These are also the kit's defaults when the two lines are left out.
MARGIN_PCT=100
MIN_MARGIN_USD=1.00
# Your own price list over the formula: fixed prices, a margin per country, plans turned off.
# cp config/prices.example.csv config/prices.csv, edit it, then uncomment (docs/en/operator-guide.md, step 5).
# PRICES_FILE=/config/prices.csv

# ── Where the eSIMs come from (docs/en/integrations.md) ──────────────────────────────────
# esimaccess (keys in secrets/esimaccess_*), airalo, esimgo, or http (your own system).
SUPPLIER=esimaccess
# SUPPLIER=airalo:  AIRALO_CLIENT_ID_FILE=/run/secrets/esim/airalo_client_id  AIRALO_CLIENT_SECRET_FILE=/run/secrets/esim/airalo_client_secret
# SUPPLIER=esimgo:  ESIMGO_API_KEY_FILE=/run/secrets/esim/esimgo_api_key
# SUPPLIER=http:    SUPPLIER_URL=https://ops.example.com/esim  SUPPLIER_SECRET_FILE=/run/secrets/esim/supplier_secret

# ── Your own systems: every order's status, signed (CRM, billing, Telegram, Sheets…) ─────
# WEBHOOK_URL=https://crm.example.com/hooks/esim
# WEBHOOK_SECRET_FILE=/run/secrets/esim/webhook_secret

# 1 = demo: live prices, a banner on every page, no payment taken. Set 0 to sell.
DEMO_MODE=1

# ── Refunds to agents (optional; docs/en/cases.md) ───────────────────────────────────────
# An agent can ask for a refund of an eSIM it has not installed. Without a refund wallet the node
# cancels the eSIM and tells you (webhook agent_order.refund_due) to pay the price back yourself.
# With one, it pays back by itself, in USDC through the facilitator (the wallet needs no ETH).
# REFUND_KEY_FILE=/run/secrets/esim/refund_key
# REFUND_MAX_USD=20
# REFUND_DAILY_MAX_USD=100

# ── Where buyers pay you: ADDRESSES ONLY — never a private key or a seed phrase ─────────
# One EVM address receives USDC/USDT on Base, Ethereum, Arbitrum, OP, Polygon, BNB Chain, Avalanche.
PAY_TO_EVM=
PAY_TO_TON=
PAY_TO_TRON=
PAY_TO_SOLANA=
# Which EVM networks to offer (chain ids). Default: all seven.
EVM_CHAINS=8453,1,42161,10,137,56,43114

# Optional: your own RPC endpoints (the public ones are rate limited).
# EVM_RPC_1=https://…
# EVM_RPC_56=https://…
# SOLANA_RPC=https://…

# Your own hub instead of the federation node (docs/<lang>/own-hub.md): Caddy sends the federation
# paths there. Leave unset for the node.
# FEDERATION_UPSTREAM=hub:9083
# One sentence about your store, shown next to its name by other hubs and maps (your own hub only).
# HUB_DESCRIPTION=Travel eSIMs for 200 countries, for people and AI agents
