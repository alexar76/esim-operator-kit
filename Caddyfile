# HTTPS for DOMAIN (Let's Encrypt, renewed by Caddy) and the three services behind it.
{$DOMAIN} {
	encode gzip
	# The federation node, or your own hub (FEDERATION_UPSTREAM=hub:9083, docs/<lang>/own-hub.md):
	# hubs read the signed manifest here and invoke esim.quote; a hub also answers MCP and A2A.
	handle /.well-known/ai-market.json {
		reverse_proxy {$FEDERATION_UPSTREAM:node:9090}
	}
	handle /.well-known/agent-card.json {
		reverse_proxy {$FEDERATION_UPSTREAM:node:9090}
	}
	handle /ai-market/* {
		reverse_proxy {$FEDERATION_UPSTREAM:node:9090}
	}
	handle /a2a* {
		reverse_proxy {$FEDERATION_UPSTREAM:node:9090}
	}
	handle /mcp* {
		reverse_proxy {$FEDERATION_UPSTREAM:node:9090}
	}
	# The seller node for agents: /agents/quote, /agents/status, /agents/order (x402).
	handle_path /agents/* {
		reverse_proxy rails:9490
	}
	# Everything else is the storefront.
	handle {
		reverse_proxy store:9495
	}
}
